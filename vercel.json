{
  "version": 2,
  "builds": [
    { "src": "scripts/server.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "styles/**", "use": "@vercel/static" },
    { "src": "scripts/main.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/chat", "dest": "scripts/server.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}